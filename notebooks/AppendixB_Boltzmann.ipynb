APPENDIX_B_NOTEBOOK = r'''{
 "nbformat": 4,
 "nbformat_minor": 5,
 "metadata": {
  "kernelspec": {"display_name": "Python 3", "language": "python", "name": "python3"},
  "language_info": {"name": "python", "version": "3.11.0"}
 },
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Appendix B: Coupled Boltzmann Equations for the Dark Octet\n",
    "\n",
    "This notebook implements and solves the eight-species coupled Boltzmann hierarchy\n",
    "described in Appendix B of the paper, reproducing:\n",
    "\n",
    "- Equilibrium yield $Y_i^{\\rm eq}(x)$ for each octet member\n",
    "- Effective thermally-averaged cross-section $\\langle\\sigma_{\\rm eff}v\\rangle$\n",
    "- Freeze-out temperature $x_f \\simeq 25$\n",
    "- Final yield $Y^\\infty_{\\chi^0} \\simeq 1.2\\times 10^{-9}$\n",
    "- Relic density $\\Omega_{\\rm DM}h^2 \\simeq 0.120$\n",
    "\n",
    "## The Boltzmann Equation\n",
    "\n",
    "$$\\frac{dY_i}{dx} = -\\frac{s(x)}{H(x)\\,x}\\sum_{j,k,l}\\langle\\sigma_{ij\\to kl}v\\rangle\\!\\left(Y_iY_j - Y_k^{\\rm eq}Y_l^{\\rm eq}\\right) + \\frac{1}{H(x)\\,x}\\!\\left(\\sum_j\\Gamma_{j\\to i}Y_j - \\sum_j\\Gamma_{i\\to j}Y_i\\right)$$\n",
    "\n",
    "where $x \\equiv M_0/T$ and $s = (2\\pi^2/45)g_{*s}T^3$."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "sys.path.insert(0, '../src')\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.special import kn\n",
    "from IPython.display import display, Math\n",
    "\n",
    "from dark_octet.boltzmann.solver import BoltzmannSolver\n",
    "from dark_octet.boltzmann.cross_sections import effective_sigma_v\n",
    "from dark_octet.boltzmann.decay_rates import compute_all_decay_rates\n",
    "from dark_octet.spectrum.gmo_formula import GMOMassOperator\n",
    "from dark_octet.relic.abundance import RelicAbundance\n",
    "from dark_octet.constants import BENCH, PHYS\n",
    "\n",
    "print('Libraries loaded.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "gmo = GMOMassOperator()\n",
    "df_spec = gmo.mass_spectrum_dataframe()\n",
    "print('Dark octet mass spectrum:')\n",
    "print(df_spec[['State','Mass_GeV','DeltaM_GeV','g_dof']].to_string(index=False))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "masses = df_spec['Mass_GeV'].values\n",
    "g_dof  = df_spec['g_dof'].values.astype(float)\n",
    "M0     = BENCH.M0\n",
    "m_dm   = masses[df_spec['Name'].tolist().index('chi_0')]\n",
    "\n",
    "x_arr = np.linspace(1, 100, 300)\n",
    "\n",
    "def yeq_single(i, x):\n",
    "    m_i  = masses[i]\n",
    "    g_i  = g_dof[i]\n",
    "    x_i  = x * m_i / M0\n",
    "    if x_i > 700:\n",
    "        return 0.0\n",
    "    return 45.0/(4*np.pi**4) * g_i/PHYS.g_star_sm * x_i**2 * kn(2, x_i)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(9, 5))\n",
    "for i, row in df_spec.iterrows():\n",
    "    yeq = np.array([yeq_single(i, x) for x in x_arr])\n",
    "    ax.semilogy(x_arr, yeq, linewidth=1.2, label=row['State'])\n",
    "ax.set_xlabel(r'$x = M_0/T$', fontsize=13)\n",
    "ax.set_ylabel(r'$Y_i^{\\rm eq}(x)$', fontsize=13)\n",
    "ax.set_title('Equilibrium Yields for All Dark Octet Members', fontsize=13)\n",
    "ax.legend(fontsize=8, ncol=2)\n",
    "ax.set_xlim(1, 80)\n",
    "ax.set_ylim(1e-14, 1e-6)\n",
    "ax.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.savefig('../data/equilibrium_yields_all.pdf', dpi=150)\n",
    "plt.show()\n",
    "print('Figure saved.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "x_test_values = [10, 20, 25, 30, 50]\n",
    "print(f'{'x':>6}  {'g_eff':>10}  {'sigma_eff_v [cm3/s]':>22}')\n",
    "print('-'*42)\n",
    "for x in x_test_values:\n",
    "    g_eff = np.sum(g_dof * (1 + (masses-m_dm)/M0)**1.5 * np.exp(-x*(masses-m_dm)/M0))\n",
    "    sv = effective_sigma_v(\n",
    "        masses_gev=masses,\n",
    "        g_dof=g_dof,\n",
    "        x=x,\n",
    "        m_dm_gev=m_dm,\n",
    "        g_dark=BENCH.g_dark,\n",
    "        g_f=BENCH.g_f,\n",
    "        m_zprime_gev=BENCH.m_zprime_gev,\n",
    "    )\n",
    "    print(f'{x:>6}  {g_eff:>10.4f}  {sv:>22.4e}')\n",
    "print(f'\\nExpected g_eff at x=25: ~10.84')\n",
    "print(f'Expected sigma_eff v at x=25: ~4.2e-26 cm3/s')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print('Running 8-species Boltzmann solver (BDF, rtol=1e-9)...')\n",
    "solver = BoltzmannSolver(x_init=1.0, x_final=800.0, n_points=3000)\n",
    "sol = solver.solve()\n",
    "solver.print_results(sol)\n",
    "solver.plot_yields(sol, save_path='../data/yields_boltzmann.pdf')\n",
    "print('\\nYield plot saved to ../data/yields_boltzmann.pdf')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "ra = RelicAbundance()\n",
    "xf = ra.freeze_out_x()\n",
    "omega = ra.omega_dm_h2_lee_weinberg()\n",
    "sigma_si = ra.sigma_si_kinetic_mixing()\n",
    "\n",
    "enh = ra.co_annihilation_enhancement_factor(\n",
    "    masses_gev=masses, g_dof=g_dof, xf=xf\n",
    ")\n",
    "\n",
    "print(f'Lee-Weinberg formula results:')\n",
    "print(f'  x_f             = {xf:.3f}       (paper: ~25)')\n",
    "print(f'  Omega_DM h2     = {omega:.4f}    (Planck: 0.1200 +/- 0.0012)')\n",
    "print(f'  Co-ann. factor  = {enh:.3f}')\n",
    "print(f'  sigma_SI [cm2]  = {sigma_si:.4e}  (LZ limit: 9.2e-48 cm2)')\n",
    "print(f'  DARWIN target   = 3.0e-49 cm2')\n",
    "print(f'  Detectable by DARWIN: {sigma_si > 3e-49}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "masses_dict = dict(zip(df_spec['Name'].tolist(), masses))\n",
    "decay_info  = compute_all_decay_rates(\n",
    "    masses_gev=masses_dict,\n",
    "    m_dm_gev=m_dm,\n",
    "    m_phi_gev=0.01,\n",
    "    g_dark=BENCH.g_dark,\n",
    ")\n",
    "\n",
    "print(f'{'State':<12}  {'DeltaM [GeV]':>14}  {'Gamma [GeV]':>14}  {'tau [s]':>14}  {'Stable'}')\n",
    "print('-'*72)\n",
    "for name, info in decay_info.items():\n",
    "    dm_str   = f\"{info['delta_m_gev']:>+14.4f}\"\n",
    "    rate_str = f\"{info['decay_rate_gev']:>14.4e}\" if not info['stable'] else f\"{'0':>14}\"\n",
    "    tau_str  = f\"{'inf':>14}\" if info['stable'] else f\"{info['lifetime_s']:>14.4e}\"\n",
    "    stable   = 'YES' if info['stable'] else 'no'\n",
    "    print(f'{name:<12}  {dm_str}  {rate_str}  {tau_str}  {stable}')\n",
    "\n",
    "bbn_timescale = 1e-3\n",
    "print(f'\\nBBN timescale: ~{bbn_timescale:.1e} s')\n",
    "print('All unstable states decay before BBN: ', end='')\n",
    "all_before_bbn = all(\n",
    "    info['lifetime_s'] < bbn_timescale\n",
    "    for name, info in decay_info.items()\n",
    "    if not info['stable'] and info['decay_rate_gev'] > 0\n",
    ")\n",
    "print('YES' if all_before_bbn else 'NO')"
   ]
  }
 ]
}'''