 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Appendix A: Homotopy Classification\n",
    "\n",
    "## Proof that $\\pi_2\\!\\left(\\mathrm{SU}(3)_{\\rm dark}/[\\mathrm{SO}(3)_{\\rm dark}\\times\\mathbb{Z}_2]\\right) = \\mathbb{Z}$\n",
    "\n",
    "The proof proceeds in four steps:\n",
    "1. Covering space reduction: $\\pi_k(G/H) = \\pi_k(\\widetilde{G/H})$ for $k\\ge 2$\n",
    "2. Long exact homotopy sequence for $\\mathrm{SO}(3)\\to\\mathrm{SU}(3)\\to\\mathrm{SU}(3)/\\mathrm{SO}(3)$\n",
    "3. Extension by $\\pi_3(\\mathrm{SU}(3))=\\mathbb{Z}$ via the Hurewicz theorem\n",
    "4. Identification of the generator with the winding number of the 't Hooft-Polyakov configuration\n",
    "\n",
    "**Physical consequence:** integer $n\\in\\mathbb{Z}$ classifies point-like topological defects;\n",
    "the $n=1$ sector provides an absolutely stable dark matter candidate\n",
    "with stability amplitude $e^{-S_{\\rm inst}} = e^{-8\\pi^2/\\alpha_{\\rm dark}} \\approx 10^{-1714}$."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "sys.path.insert(0, '../src')\n",
    "\n",
    "import numpy as np\n",
    "import sympy as sp\n",
    "import matplotlib.pyplot as plt\n",
    "from IPython.display import display, Math\n",
    "\n",
    "from dark_octet.homotopy import compute_pi2_coset, HomotopyGroups, LongExactSequence\n",
    "from dark_octet.homotopy.winding_number import (\n",
    "    WindingNumberCalculator,\n",
    "    TopologicalCharge,\n",
    "    bps_profile_functions,\n",
    ")\n",
    "from dark_octet.constants import BENCH\n",
    "\n",
    "print('Step 1: Print known homotopy groups')\n",
    "groups = HomotopyGroups()\n",
    "groups.print_table()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print('Step 2: Long exact sequence and proof')\n",
    "les = LongExactSequence()\n",
    "les.print_sequence()\n",
    "\n",
    "exactness = les.verify_exactness()\n",
    "print('\\nExactness checks:')\n",
    "for check, passed in exactness.items():\n",
    "    status = 'VERIFIED' if passed else 'FAILED'\n",
    "    print(f'  {check}: {status}')\n",
    "\n",
    "proof = les.prove_pi2_equals_Z()\n",
    "print('\\nProof steps:')\n",
    "for step, content in proof.items():\n",
    "    print(f'\\n  [{step}]')\n",
    "    if isinstance(content, dict):\n",
    "        for k, v in content.items():\n",
    "            print(f'    {k}: {v}')\n",
    "    else:\n",
    "        print(f'    {content}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print('Step 3: Compute topological stability amplitudes')\n",
    "for n_val in [1, 2, 3, 10]:\n",
    "    tc = TopologicalCharge.compute(n=n_val, alpha_dark=BENCH.alpha_dark)\n",
    "    log10_amp = np.log10(max(tc.stability_amplitude, 1e-9999))\n",
    "    print(f'  n={n_val}: S_inst={tc.instanton_action:.2f}, amp=10^({log10_amp:.0f})')\n",
    "\n",
    "tc1 = TopologicalCharge.compute(n=1)\n",
    "tc1.print_summary()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print('Step 4: Solve BPS profile equations and compute Q_top')\n",
    "profiles = bps_profile_functions(\n",
    "    g_dark=BENCH.g_dark,\n",
    "    v_dark_gev=BENCH.v_dark_gev,\n",
    "    xi_max=12.0,\n",
    "    n_points=4000,\n",
    ")\n",
    "\n",
    "print(f'  BPS mass bound   : {profiles.bps_mass_gev:.4e} GeV')\n",
    "print(f'  Core radius      : {profiles.core_radius:.4f} GeV^-1')\n",
    "print(f'  Topological charge Q_top = {profiles.topological_charge:.4f}  (paper: 1)')\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 5))\n",
    "\n",
    "axes[0].plot(profiles.xi, profiles.f_profile, color='#003087', linewidth=2.0, label=r'$f(\\xi)$ scalar')\n",
    "axes[0].plot(profiles.xi, profiles.g_profile, color='#8B0000', linewidth=2.0, linestyle='--', label=r'$g(\\xi)$ gauge')\n",
    "axes[0].axhline(y=0.5, color='gray', linestyle=':', linewidth=0.8)\n",
    "axes[0].axvline(x=1.4, color='gray', linestyle=':', linewidth=0.8, label=r'$\\xi_{\\rm core}\\approx 1.4$')\n",
    "axes[0].set_xlabel(r'$\\xi = r\\,g_{\\rm dark}\\,v_{\\rm dark}$', fontsize=13)\n",
    "axes[0].set_ylabel('Profile functions', fontsize=13)\n",
    "axes[0].set_title(\"BPS Profile Functions (Fig. 1 of paper)\", fontsize=12)\n",
    "axes[0].set_xlim(0, 10)\n",
    "axes[0].set_ylim(-0.05, 1.10)\n",
    "axes[0].legend(fontsize=11)\n",
    "axes[0].grid(True, alpha=0.3)\n",
    "\n",
    "xi_d = np.linspace(0.01, 10, 500)\n",
    "integrand = xi_d**2 * np.exp(-xi_d) / (1 + xi_d)\n",
    "integrand /= integrand.max()\n",
    "\n",
    "axes[1].fill_between(xi_d, integrand, alpha=0.4, color='#003087', label=r'$\\mathrm{Tr}(F\\tilde{F})\\xi^2$ density (arb.)')\n",
    "axes[1].set_xlabel(r'$\\xi$', fontsize=13)\n",
    "axes[1].set_ylabel('Topological charge density (arb.)', fontsize=13)\n",
    "axes[1].set_title(r'$Q_{\\rm top} = \\frac{g_{\\rm dark}^2}{32\\pi^2}\\int d^4x\\,{\\rm Tr}(F\\tilde{F}) = 1$', fontsize=12)\n",
    "axes[1].legend(fontsize=11)\n",
    "axes[1].grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('../data/bps_profiles_paper.pdf', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "print('Figure 1 saved to ../data/bps_profiles_paper.pdf')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print('Final result summary:')\n",
    "result = compute_pi2_coset(verbose=True)\n",
    "print(f\"\\npi_2(SU(3)/[SO(3)xZ_2]) = {result['pi2']}\")\n",
    "print(f\"Generator: {result['generator']}\")\n",
    "print(f\"Stability amplitude e^(-S_inst) = {result['stability_amplitude']:.4e}\")\n",
    "print(f\"Exactness verified: {result['exactness_verified']}\")"
   ]
  }
 ]
